{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satpass",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "VAPID_SUBJECT": "mailto:satpass@lukedw09.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "ALERTS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
